# Server port (default: 3001)
PORT=3001

# ─── Database ───────────────────────────────────────────────────
# Option A — Cloud PostgreSQL (Neon, Supabase, Render, etc.)
# If DATABASE_URL is set, the server will use it (SSL enabled automatically).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B — Local PostgreSQL (individual vars, used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=returndesk
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password

# ─── CORS ───────────────────────────────────────────────────────
# URL of the Next.js frontend (for CORS).
# Dev: http://localhost:3000
# Production: set to your Vercel deployment URL (e.g. https://returndesk.vercel.app)
CLIENT_URL=http://localhost:3000
