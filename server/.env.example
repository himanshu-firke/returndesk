# Server port (default: 3001)
PORT=3001

# ─── Database Configuration ─────────────────────────────────────
# Option A: Cloud PostgreSQL (Recommended: Neon, Supabase, Render)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Local PostgreSQL (Alternative if not using DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=returndesk
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password

# ─── CORS ───────────────────────────────────────────────────────
# URL of the Next.js frontend (for CORS).
# Dev:        http://localhost:3000
# Production: https://returndesk-ten.vercel.app (or your live frontend domain)
CLIENT_URL=http://localhost:3000
